#!/bin/bash
#PBS -N cond_eval
#PBS -q normal
#PBS -P 11610002
#PBS -l select=1:ngpus=2
#PBS -l walltime=02:00:00

set -euo pipefail

: "${input:?Usage: qsub -v input='--model <model-id> <infer options>' cond_recirculate.pbs}"

export PYTHONUNBUFFERED=1

cd "$PBS_O_WORKDIR" || exit 1
exec > "pbs-${PBS_JOBID}.out" 2> "pbs-${PBS_JOBID}.err"

set -x
python infer.py --do-eval $input
